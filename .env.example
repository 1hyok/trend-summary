# Google Gemini API key — required for LLM summarization (free tier OK, no card)
# Get at: https://aistudio.google.com/ → "Get API key"
GOOGLE_API_KEY=

# YouTube Data API key — optional (if missing, YouTube source is skipped)
# Get at: https://console.cloud.google.com/ → enable "YouTube Data API v3"
YOUTUBE_API_KEY=
